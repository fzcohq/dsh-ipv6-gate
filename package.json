{
  "name": "dsh-ipv6-gate",
  "version": "0.1.1",
  "description": "IPv6 远程访问网关插件：DDNS + ACME HTTPS + 认证反代，把 DeepSeek Harness 零中继暴露到公网 IPv6（免费、数据不经第三方）。IPv6 remote-access gateway for DSH: DDNS + ACME TLS + auth reverse proxy, no relay in the data path.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "remote-access",
    "ipv6",
    "ddns",
    "acme",
    "lets-encrypt",
    "reverse-proxy",
    "手机远程",
    "远程访问"
  ],
  "scripts": {
    "test": "node --test --test-force-exit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "selfsigned": "^5.5.0"
  }
}
